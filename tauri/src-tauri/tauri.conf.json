{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Kriko",
    "version": "0.3.3",
    "identifier": "org.kriko.app",
    "build": {
        "frontendDist": "../shell-ui"
    },
    "app": {
        "windows": [
            {
                "title": "Kriko",
                "width": 1100,
                "height": 780,
                "minWidth": 620,
                "minHeight": 520,
                "resizable": true,
                "visible": false,
                "label": "main"
            }
        ],
        "security": {
            "csp": null
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "dmg",
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/kriko-sidecar"
        ],
        "shortDescription": "Local product knowledge",
        "longDescription": "Kriko answers what is known to go wrong with a specific manufactured product, from knowledge packs installed on your own machine.",
        "windows": {
            "nsis": {
                "installerHooks": "installer.nsh"
            }
        }
    },
    "plugins": {}
}
