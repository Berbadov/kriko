  position: relative;
  display: block;
  background: transparent;
  --sui-stepper-horizontal-connector-width: 69px;
  --sui-stepper-horizontal-start-padding: 0px;
  --sui-stepper-horizontal-end-padding: 0px;
}

.active {
  color: var(--sui-semantic-component-stepper-active);
  border-color: var(--sui-semantic-component-stepper-active) !important;
}

.sui-stepper__container {
  display: grid;
  position: relative;
  height: 100%;
  box-sizing: border-box;
  background: transparent;
  color: var(--sui-semantic-component-stepper-passive-countents);
}
.sui-stepper__container--steps {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  gap: var(--sui-spacing-md);
}
.sui-stepper__container--steps.vertical {
  flex-direction: column;
  justify-content: center;
  min-height: 600px;
}
.sui-stepper__container--steps.horizontal {
  flex-direction: row;
  justify-content: flex-start;
  gap: var(--sui-spacing-md);
  padding-inline-start: var(--sui-stepper-horizontal-start-padding, 0px);
  padding-inline-end: var(--sui-stepper-horizontal-end-padding, 0px);
  box-sizing: border-box;
}
.sui-stepper__container--steps__item-text, .sui-stepper__container--steps__item-text--measure {
  display: block;
  text-align: center;
  font-weight: 600;
  font-style: normal;
  font-size: var(--sui-font-size-md);
  min-width: 90px;
  white-space: nowrap;
}
.sui-stepper__container--steps__item-text {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.sui-stepper__container--steps__item-text--measure {
  position: absolute;
  inset: 0 auto auto 0;
  pointer-events: none;
  user-select: none;
  visibility: hidden;
}
.sui-stepper__container--steps__item-container--number {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--sui-semantic-component-stepper-passive);
  border-radius: 50%;
  width: 30px;
  height: 30px;
}
.sui-stepper__container--steps__item-container--number.completed {
  color: var(--sui-surface-level-1);
  border-color: var(--sui-semantic-component-stepper-completed);
  background-color: var(--sui-semantic-component-stepper-completed);
}
.sui-stepper__container--steps__item-container--number.completed::before {
  font-family: "sui-icon-base" !important;
  content: var(--sui-i-check);
  font-size: var(--sui-icon-large);
}
.sui-stepper__container--steps__item-container--content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  position: relative;
  cursor: pointer;
  padding-bottom: 25px;
}
.sui-stepper__container--steps__item-container--content.loading {
  color: var(--sui-semantic-component-stepper-passive) !important;
}
.sui-stepper__container--steps__item-container.horizontal {
  flex: 0 0 auto;
}
.sui-stepper__container--steps__item-container:not(:first-child) {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 12px;
}
.sui-stepper__container--steps__item-container:not(:first-child).active {
  color: var(--sui-semantic-component-stepper-active);
  border-color: var(--sui-semantic-component-stepper-active);
}
.sui-stepper__container--steps__item-container:not(:first-child).active.vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sui-stepper__container--steps__item-container:not(:first-child).active.vertical::before {
  content: "";
  position: relative;
  box-sizing: border-box;
  border: 2px solid var(--sui-semantic-component-stepper-active);
  border-radius: 8px;
  height: 100%;
  min-height: 69px;
}
.sui-stepper__container--steps__item-container:not(:first-child).active.horizontal::before {
  content: "";
  position: relative;
  box-sizing: border-box;
  border: 2px solid var(--sui-semantic-component-stepper-active);
  border-radius: 8px;
  width: var(--sui-stepper-horizontal-connector-width, 69px);
  min-width: 0;
  flex: 0 0 var(--sui-stepper-horizontal-connector-width, 69px);
  margin-bottom: 16px;
}
.sui-stepper__container--steps__item-container:not(:first-child).vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.sui-stepper__container--steps__item-container:not(:first-child).vertical::before {
  content: "";
  position: relative;
  box-sizing: border-box;
  border: 2px solid var(--sui-semantic-component-stepper-passive);
  border-radius: 8px;
  height: 100%;
  min-height: 69px;
}
.sui-stepper__container--steps__item-container:not(:first-child).horizontal {
  width: auto;
}
.sui-stepper__container--steps__item-container:not(:first-child).horizontal::before {
  content: "";
  position: relative;
  box-sizing: border-box;
  border: 2px solid var(--sui-semantic-component-stepper-passive);
  border-radius: 8px;
  width: var(--sui-stepper-horizontal-connector-width, 69px);
  min-width: 0;
  flex: 0 0 var(--sui-stepper-horizontal-connector-width, 69px);
  margin-bottom: 16px;
}

.sui-i-indeterminate_spinner::before {
  font-family: "sui-icon-base" !important;
