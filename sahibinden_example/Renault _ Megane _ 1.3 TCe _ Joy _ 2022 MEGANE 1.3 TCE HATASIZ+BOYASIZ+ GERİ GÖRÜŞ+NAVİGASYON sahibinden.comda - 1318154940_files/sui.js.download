    font-size: var(--sui-font-size-sm);
    line-height: 16px;
  }
  .sui-file-upload .sui-file-upload__drop {
    min-height: 44px;
    padding: 0 var(--sui-spacing-md);
    gap: var(--sui-spacing-2xs);
    border: 1px solid var(--sui-semantic-border-primary);
    border-radius: var(--sui-border-radius-sm);
    background-color: var(--sui-semantic-surface-background-level-0);
    box-shadow: 0 2px 4px 0 var(--sui-alpha-black-12);
  }
  .sui-file-upload .sui-file-upload__drop:hover {
    border-color: var(--sui-semantic-border-primary);
  }
  .sui-file-upload .sui-file-upload__drop-icon {
    width: 24px;
    height: 24px;
    font-size: var(--sui-font-size-3xl);
    color: var(--sui-semantic-icon-action);
  }
  .sui-file-upload .sui-file-upload__drop-icon::before {
    content: var(--sui-i-plus_add_line);
  }
  .sui-file-upload .sui-file-upload__drop-text {
    align-items: center;
    min-width: 0;
  }
  .sui-file-upload .sui-file-upload__drop-title {
    font-size: var(--sui-font-size-md);
    font-weight: var(--sui-font-weight-bold);
    line-height: 20px;
    color: var(--sui-semantic-text-accent);
  }
  .sui-file-upload .sui-file-upload__drop-hint {
    display: none;
  }
  .sui-file-upload .sui-file-upload__hint {
    font-size: var(--sui-font-size-sm);
    line-height: 16px;
  }
  .sui-file-upload[data-state=disable] .sui-file-upload__drop-icon, .sui-file-upload[data-upload-locked=true] .sui-file-upload__drop-icon, .sui-file-upload[data-disabled=true] .sui-file-upload__drop-icon {
    color: var(--sui-semantic-component-button-primary-disabled-contents);
  }
  .sui-file-upload[data-state=disable] .sui-file-upload__drop, .sui-file-upload[data-upload-locked=true] .sui-file-upload__drop, .sui-file-upload[data-disabled=true] .sui-file-upload__drop {
