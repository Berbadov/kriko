  --sui-icon-xlarge: 32px;
  --sui-icon-xxlarge: 56px;
}

[class^=sui-i-].tiny,
[class*=" sui-i-"].tiny {
  font-size: 16px;
}
[class^=sui-i-].medium,
[class*=" sui-i-"].medium {
  font-size: 20px;
}
[class^=sui-i-].large,
