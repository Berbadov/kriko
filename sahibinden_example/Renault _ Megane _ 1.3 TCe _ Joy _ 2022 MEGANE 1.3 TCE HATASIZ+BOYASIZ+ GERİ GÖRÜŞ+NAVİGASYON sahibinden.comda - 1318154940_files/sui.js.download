:host {
  display: block;
  box-sizing: border-box;
}
:host * {
  box-sizing: border-box;
}

.sui-filter-group__outer {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: var(--sui-spacing-xs);
  width: 100%;
}

.sui-filter-group__chips-area {
  flex: 1;
  min-width: 0;
}

.sui-filter-group__quick-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.sui-filter-group {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: var(--sui-spacing-xs);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 0 var(--sui-spacing-3xs);
  border-radius: var(--sui-border-radius-sm);
  min-height: 52px;
}

.sui-filter-group::-webkit-scrollbar {
  display: none;
}

:host([sui-size=small]) .sui-filter-group {
  min-height: 40px;
  padding: var(--sui-spacing-xs) var(--sui-spacing-3xs);
}

.sui-filter-group__mobile-wrap .sui-filter-group {
  padding: 10px var(--sui-spacing-md);
  border-radius: 0;
  min-height: 44px;
}

.sui-filter-group__mobile-wrap {
  display: flex;
  align-items: center;
  position: relative;
  border-radius: 0;
  min-height: 44px;
  width: 100%;
  box-shadow: var(--sui-primitive-depth-2a);
}

:host([sui-size=small]) .sui-filter-group__mobile-wrap {
  min-height: 40px;
}

.sui-filter-group__viewport-wrapper {
  position: relative;
  flex: 1;
  min-width: 0;
}

.sui-filter-group__mobile-wrap .sui-filter-group__scroll-viewport {
  flex: 1;
  min-width: 0;
  /* Yatay 16px boşluk gölgenin olduğu bu divde; içerik sol/sağ duvardan boşluklu olur */
  padding-left: var(--sui-spacing-md);
  padding-right: var(--sui-spacing-md);
}

.sui-filter-group__scroll-btn {
  position: absolute;
  top: 7px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  background-color: var(--sui-semantic-surface-background-level-0);
  color: var(--sui-semantic-icon-secondary);
  cursor: pointer;
}
.sui-filter-group__scroll-btn--left {
  left: 0;
  border-right: 1px solid var(--sui-semantic-component-divider-primary);
}
.sui-filter-group__scroll-btn--right {
  right: 0;
  border-left: 1px solid var(--sui-semantic-component-divider-primary);
}

/* Small: bar 40px olduğu için buton yüksekliği ve konumu */
:host([sui-size=small]) .sui-filter-group__scroll-btn {
  top: 4px;
  height: 32px;
  padding: 0;
}

