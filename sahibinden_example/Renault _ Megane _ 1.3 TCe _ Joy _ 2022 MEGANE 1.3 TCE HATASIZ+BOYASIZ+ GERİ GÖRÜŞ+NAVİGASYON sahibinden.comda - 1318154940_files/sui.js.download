.sui-float-slot {
  display: inline-block;
}

.sui-float-slot__trigger {
  display: inline-block;
  cursor: pointer;
  outline: none;
}
.sui-float-slot__trigger:focus-visible {
  outline: 2px solid var(--sui-semantic-state-focus-default);
  outline-offset: var(--sui-spacing-2xs, 4px);
}

.sui-float-slot__panel {
  position: fixed;
  z-index: 1000;
  width: max-content;
  min-width: min(313px, 100vw - 32px);
  max-width: none;
  max-height: calc(100vh - 16px);
  padding: var(--sui-spacing-md);
  border-radius: var(--sui-border-radius-md);
  background: var(--sui-semantic-component-float-slot-background);
  box-shadow: 0 2px 12px 0 var(--sui-semantic-depth-component-modal-color);
  overflow: visible;
}
.sui-float-slot__panel::after {
  content: "";
  position: absolute;
  width: 10px;
  height: 10px;
  background: var(--sui-semantic-component-float-slot-background);
  transform: rotate(45deg);
}
.sui-float-slot__panel[data-position^=bottom]::after {
  top: -5px;
  left: var(--sui-float-slot-arrow-left, var(--sui-spacing-md));
  margin-left: -5px;
}
.sui-float-slot__panel[data-position^=top]::after {
  bottom: -5px;
  left: var(--sui-float-slot-arrow-left, var(--sui-spacing-md));
  margin-left: -5px;
}
.sui-float-slot__panel[data-position^=left]::after {
  right: -5px;
  top: var(--sui-float-slot-arrow-top, var(--sui-spacing-md));
  margin-top: -5px;
}
.sui-float-slot__panel[data-position^=right]::after {
  left: -5px;
  top: var(--sui-float-slot-arrow-top, var(--sui-spacing-md));
  margin-top: -5px;
}

.sui-float-slot__content {
  position: relative;
  z-index: 1;
  width: max-content;
  max-width: none;
  max-height: calc(100vh - 48px);
  overflow-x: visible;
  overflow-y: auto;
  background: var(--sui-semantic-component-float-slot-slot-bg);
  scrollbar-color: var(--sui-semantic-component-float-slot-scrool) transparent;
}
.sui-float-slot__content::-webkit-scrollbar {
  width: var(--sui-spacing-2xs, 4px);
  height: var(--sui-spacing-2xs, 4px);
}
.sui-float-slot__content::-webkit-scrollbar-thumb {
  background: var(--sui-semantic-component-float-slot-scrool);
