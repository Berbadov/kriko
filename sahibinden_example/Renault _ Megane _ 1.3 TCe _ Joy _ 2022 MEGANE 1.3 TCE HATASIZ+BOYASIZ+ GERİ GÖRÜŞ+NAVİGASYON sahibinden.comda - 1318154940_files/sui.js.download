  display: block;
  width: 100%;
  box-sizing: border-box;
}
:host * {
  box-sizing: border-box;
}
:host [class^=sui-i-],
:host [class*=" sui-i-"] {
  font-family: "sui-icon-base" !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
:host .sui-i-x_close::before {
  content: var(--sui-i-x_close);
}
:host .sui-i-trash_line::before {
  content: var(--sui-i-trash_line);
}
:host .sui-i-exclamation_circle_solid::before {
  content: var(--sui-i-exclamation_circle_solid);
}
:host .sui-i-plus_add_line::before {
  content: var(--sui-i-plus_add_line);
}

:host([disabled]) {
  cursor: not-allowed;
}

.sui-file-upload {
  display: flex;
  flex-direction: column;
  gap: var(--sui-spacing-xs);
  width: 100%;
}
.sui-file-upload__input {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.sui-file-upload sui-label {
  gap: var(--sui-spacing-3xs);
}
.sui-file-upload sui-label .sui-label__text {
  color: var(--sui-semantic-text-primary);
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  line-height: var(--sui-line-height-sm);
}
.sui-file-upload sui-label .sui-label__description {
  color: var(--sui-semantic-text-secondary);
  font-size: var(--sui-font-size-sm);
  font-weight: var(--sui-font-weight-regular);
  line-height: var(--sui-line-height-xs);
}
.sui-file-upload__content {
  display: flex;
  flex-direction: column;
  gap: var(--sui-spacing-xs);
}
.sui-file-upload__drop {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sui-spacing-md);
  min-height: 72px;
  padding: var(--sui-spacing-sm) var(--sui-spacing-4xl);
  background-color: var(--sui-semantic-surface-background-level-1);
  border: 1px dashed var(--sui-semantic-border-alpha-level-2);
  border-radius: var(--sui-border-radius-sm);
  color: var(--sui-semantic-text-secondary);
  cursor: pointer;
  user-select: none;
  transition: background-color 120ms ease, border-color 120ms ease;
}
.sui-file-upload__drop:focus-visible {
  outline: 2px solid var(--sui-semantic-border-focus);
  outline-offset: 2px;
}
.sui-file-upload__drop:hover {
  border-color: var(--sui-semantic-border-alpha-level-3);
}
.sui-file-upload__drop-icon {
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sui-font-size-4xl);
  color: var(--sui-semantic-text-accent);
}
.sui-file-upload__drop-icon::before {
  font-family: "sui-icon-base" !important;
  content: var(--sui-i-new_ad_solid);
}
.sui-file-upload__drop-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: var(--sui-spacing-3xs);
  line-height: 1;
}
.sui-file-upload__drop-title {
  color: var(--sui-semantic-text-accent);
  font-size: var(--sui-font-size-sm);
  font-weight: var(--sui-font-weight-bold);
  line-height: 16px;
}
.sui-file-upload__drop-hint {
  color: var(--sui-semantic-text-tertiary);
  font-size: var(--sui-font-size-sm);
  font-weight: var(--sui-font-weight-regular);
  line-height: 16px;
}
.sui-file-upload__list {
  display: flex;
  flex-direction: column;
  gap: var(--sui-spacing-2xs);
  padding: var(--sui-spacing-xs);
  background-color: var(--sui-semantic-surface-background-level-0);
  border: 1px solid var(--sui-semantic-border-alpha-level-1);
  border-radius: var(--sui-border-radius-sm);
  overflow: hidden;
}
.sui-file-upload__item {
  display: flex;
  flex-direction: column;
}
.sui-file-upload__item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sui-spacing-md);
  padding: var(--sui-spacing-2xs) var(--sui-spacing-xs);
}
.sui-file-upload__item-meta {
  display: flex;
  flex-direction: column;
  gap: var(--sui-spacing-3xs);
  min-width: 0;
  flex: 1 1 auto;
}
.sui-file-upload__item-name {
  color: var(--sui-semantic-text-primary);
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-regular);
  line-height: var(--sui-line-height-sm);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.sui-file-upload__item-size {
  color: var(--sui-semantic-text-tertiary);
  font-size: var(--sui-font-size-sm);
  font-weight: var(--sui-font-weight-regular);
  line-height: 16px;
}
.sui-file-upload__item-remove {
  flex: 0 0 auto;
}
.sui-file-upload__progress {
  display: flex;
  align-items: center;
  gap: var(--sui-spacing-sm);
  padding: 0 var(--sui-spacing-xs);
}
.sui-file-upload__progress-bar {
  position: relative;
  flex: 1 1 auto;
  height: 6px;
  border-radius: 6px;
  background-color: var(--sui-semantic-global-primary-soft);
  overflow: hidden;
}
.sui-file-upload__progress-fill {
  position: absolute;
  inset: 0 auto 0 0;
  height: 100%;
  background-color: var(--sui-semantic-surface-action);
  border-radius: inherit;
  transition: width 120ms ease;
}
.sui-file-upload__progress-percent {
  min-width: 32px;
  text-align: right;
  color: var(--sui-semantic-text-secondary);
  font-size: var(--sui-font-size-sm);
  line-height: 16px;
}
.sui-file-upload__hint {
  display: inline-flex;
  align-items: center;
  gap: var(--sui-spacing-2xs);
  color: var(--sui-semantic-global-error-default);
  font-size: var(--sui-font-size-sm);
  line-height: var(--sui-line-height-xs);
}
.sui-file-upload__hint-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sui-font-size-lg);
  line-height: 1;
}
.sui-file-upload[data-state=drag-hover] .sui-file-upload__drop {
  justify-content: center;
  padding: var(--sui-spacing-sm) var(--sui-spacing-4xl);
  background-color: var(--sui-semantic-global-primary-soft);
  border-color: var(--sui-semantic-border-primary);
}
.sui-file-upload[data-state=drag-hover] .sui-file-upload__drop-active {
  flex: 1 1 auto;
  color: var(--sui-semantic-text-accent);
  font-size: var(--sui-font-size-sm);
  font-weight: var(--sui-font-weight-regular);
  line-height: 16px;
  text-align: center;
}
.sui-file-upload[data-state=disable] .sui-file-upload__drop-title, .sui-file-upload[data-upload-locked=true] .sui-file-upload__drop-title, .sui-file-upload[data-disabled=true] .sui-file-upload__drop-title {
  color: var(--sui-semantic-component-button-primary-disabled-contents);
}
.sui-file-upload[data-upload-locked=true] .sui-file-upload__drop, .sui-file-upload[data-disabled=true] .sui-file-upload__drop {
  pointer-events: none;
  cursor: not-allowed;
  background-color: var(--sui-semantic-surface-background-level-1);
  border-color: var(--sui-semantic-border-alpha-level-2);
}
.sui-file-upload[data-disabled=true] {
  pointer-events: none;
}
.sui-file-upload[data-disabled=true] .sui-file-upload__item-name,
.sui-file-upload[data-disabled=true] .sui-file-upload__item-size {
  color: var(--sui-semantic-text-disabled);
}

.sui-file-upload--mobile {
  gap: var(--sui-spacing-md);
}
.sui-file-upload--mobile .sui-file-upload__content {
  gap: var(--sui-spacing-md);
}
.sui-file-upload--mobile .sui-file-upload__title {
  font-size: var(--sui-font-size-md);
  line-height: 20px;
}
.sui-file-upload--mobile .sui-file-upload__subtitle {
  font-size: var(--sui-font-size-sm);
  line-height: 16px;
}
.sui-file-upload--mobile .sui-file-upload__drop {
  min-height: 44px;
  padding: 0 var(--sui-spacing-md);
  gap: var(--sui-spacing-2xs);
  border: 1px solid var(--sui-semantic-border-primary);
  border-radius: var(--sui-border-radius-sm);
  background-color: var(--sui-semantic-surface-background-level-0);
  box-shadow: 0 2px 4px 0 var(--sui-alpha-black-12);
}
.sui-file-upload--mobile .sui-file-upload__drop:hover {
  border-color: var(--sui-semantic-border-primary);
}
.sui-file-upload--mobile .sui-file-upload__drop-icon {
  width: 24px;
  height: 24px;
  font-size: var(--sui-font-size-3xl);
  color: var(--sui-semantic-icon-action);
}
.sui-file-upload--mobile .sui-file-upload__drop-icon::before {
  content: var(--sui-i-plus_add_line);
}
.sui-file-upload--mobile .sui-file-upload__drop-text {
  align-items: center;
  min-width: 0;
}
.sui-file-upload--mobile .sui-file-upload__drop-title {
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  line-height: 20px;
  color: var(--sui-semantic-text-accent);
}
.sui-file-upload--mobile .sui-file-upload__drop-hint {
  display: none;
}
.sui-file-upload--mobile .sui-file-upload__hint {
  font-size: var(--sui-font-size-sm);
  line-height: 16px;
}
.sui-file-upload--mobile[data-state=disable] .sui-file-upload__drop-icon, .sui-file-upload--mobile[data-upload-locked=true] .sui-file-upload__drop-icon, .sui-file-upload--mobile[data-disabled=true] .sui-file-upload__drop-icon {
  color: var(--sui-semantic-component-button-primary-disabled-contents);
}
.sui-file-upload--mobile[data-state=disable] .sui-file-upload__drop, .sui-file-upload--mobile[data-upload-locked=true] .sui-file-upload__drop, .sui-file-upload--mobile[data-disabled=true] .sui-file-upload__drop {
  background-color: var(--sui-semantic-surface-background-level-0);
}

@media (max-width: 768px) {
  .sui-file-upload {
    gap: var(--sui-spacing-md);
  }
  .sui-file-upload .sui-file-upload__content {
    gap: var(--sui-spacing-md);
  }
  .sui-file-upload .sui-file-upload__title {
    font-size: var(--sui-font-size-md);
    line-height: 20px;
  }
