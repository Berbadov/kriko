.sui-tab-component {
  display: flex;
  flex-wrap: nowrap;
  align-items: flex-end;
  width: 100%;
  padding-left: 0;
  margin: 0;
  list-style: none;
  border: none;
}

.sui-tab-component__item {
  flex: 1 0 auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.sui-tab-component__link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 0 16px;
  margin: 0;
  border: none;
  cursor: pointer;
  text-decoration: none;
  color: var(--sui-semantic-component-tab-line-tab-unselected);
  background: transparent;
}
.sui-tab-component__link:hover, .sui-tab-component__link:focus {
  outline: none;
}
.sui-tab-component__link:focus-visible {
  outline: 2px solid var(--sui-primary-default);
  outline-offset: 2px;
}
.sui-tab-component__link:disabled, .sui-tab-component__link.sui-tab-component__link--disabled {
  cursor: default;
  pointer-events: none;
}

.sui-tab-component__link .sui-tab-component__icon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.sui-tab-component__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.sui-tab-component__count {
  flex-shrink: 0;
  margin-left: 0;
}

.sui-tab-component__count--badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 16px;
  min-height: 16px;
  padding: 0 4px;
  margin: 0;
  border-radius: 10px;
  background-color: var(--sui-semantic-component-badge-notifications-background);
  color: var(--sui-semantic-component-badge-notifications-contents);
  font-size: 10px;
  font-weight: 400;
  line-height: 1;
}

.sui-tab-component--3d {
  gap: 0;
}

.sui-tab-component--3d .sui-tab-component__item {
  padding-right: 4px;
  border-bottom: 1px solid var(--sui-semantic-component-tab-index-tab-border);
}
.sui-tab-component--3d .sui-tab-component__item:last-child {
  padding-right: 0;
}

.sui-tab-component--3d .sui-tab-component__link {
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  height: 40px;
  line-height: 40px;
  color: var(--sui-semantic-component-tab-index-tab-unselected);
  background-color: var(--sui-semantic-component-tab-index-tab-unselected-background);
  border-radius: 4px 4px 0 0;
  border: 1px solid var(--sui-semantic-component-tab-index-tab-border);
  border-bottom: none;
  transition: box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
}
.sui-tab-component--3d .sui-tab-component__link:hover:not(.sui-tab-component__link--active) {
  background-color: var(--sui-semantic-component-tab-index-tab-selected-background);
  color: var(--sui-semantic-component-tab-index-tab-hover);
  box-shadow: 0 -4px 0 var(--sui-semantic-component-tab-index-tab-hover);
}
.sui-tab-component--3d .sui-tab-component__link:disabled, .sui-tab-component--3d .sui-tab-component__link.sui-tab-component__link--disabled {
  color: var(--sui-semantic-component-tab-index-tab-disabled);
  background-color: var(--sui-semantic-component-tab-index-tab-disabled-background);
  border-color: var(--sui-semantic-component-tab-index-tab-disabled-border);
}

.sui-tab-component--3d .sui-tab-component__link--active {
  border: 1px solid var(--sui-semantic-component-tab-index-tab-border);
  border-bottom: none;
  background: var(--sui-semantic-component-tab-index-tab-selected-background);
  color: var(--sui-semantic-component-tab-index-tab-selected);
  box-shadow: 0 -4px 0 0 var(--sui-semantic-component-tab-index-tab-selected), 0 2px 0 -1px var(--sui-semantic-component-tab-index-tab-selected-background);
}

.sui-tab-component--inner .sui-tab-component__link {
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  height: 44px;
  color: var(--sui-semantic-component-tab-line-tab-unselected);
  background: none;
  border-bottom: 2px solid transparent;
}
.sui-tab-component--inner .sui-tab-component__link:hover {
  color: var(--sui-semantic-component-tab-line-tab-hover);
  border-bottom-color: var(--sui-semantic-component-tab-line-tab-hover);
}
.sui-tab-component--inner .sui-tab-component__link:disabled, .sui-tab-component--inner .sui-tab-component__link.sui-tab-component__link--disabled {
  color: var(--sui-semantic-component-tab-line-tab-disabled);
}

.sui-tab-component--inner .sui-tab-component__link--active {
  color: var(--sui-semantic-component-tab-line-tab-selected);
  border-bottom-color: var(--sui-semantic-component-tab-line-tab-selected);
}

.sui-tab-component--s {
  width: 100%;
  gap: var(--sui-spacing-2xs);
  padding: 0 var(--sui-spacing-md);
  border-bottom: 2px solid var(--sui-semantic-component-tab-solid-tab-selected);
}

.sui-tab-component--s .sui-tab-component__item {
  flex: 0 1 auto;
  min-width: 0;
  margin: 0;
}

.sui-tab-component--s .sui-tab-component__link {
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  height: 44px;
  color: var(--sui-semantic-component-tab-solid-tab-text);
  background: var(--sui-semantic-component-tab-solid-tab-unselected-background);
  border-width: 1px 1px 0 1px;
  border-style: solid;
  border-color: var(--sui-semantic-component-tab-solid-tab-border);
  border-radius: 4px 4px 0 0;
}
.sui-tab-component--s .sui-tab-component__link:hover:not(.sui-tab-component__link--active):not(:disabled) {
  color: var(--sui-semantic-component-tab-solid-tab-on-text);
  background: var(--sui-semantic-component-tab-solid-tab-hover);
  border-color: transparent;
}
.sui-tab-component--s .sui-tab-component__link:disabled, .sui-tab-component--s .sui-tab-component__link.sui-tab-component__link--disabled {
  font-weight: var(--sui-font-weight-regular);
  color: var(--sui-semantic-component-tab-solid-tab-disabled);
  background: var(--sui-semantic-component-tab-solid-tab-disabled-background);
  border-color: var(--sui-semantic-component-tab-solid-tab-border);
}

.sui-tab-component--s .sui-tab-component__link--active {
  color: var(--sui-semantic-component-tab-solid-tab-on-text);
  background: var(--sui-semantic-component-tab-solid-tab-selected);
  border-color: transparent;
}

@media (max-width: 767.98px) {
  .sui-tab-component--s .sui-tab-component__link {
    height: 32px;
    font-weight: var(--sui-font-weight-semibold);
