.sui-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 32px;
  border-radius: var(--sui-border-radius-pill);
  border: 1px solid transparent;
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-regular);
  line-height: normal;
  white-space: nowrap;
  user-select: none;
}
.sui-chip ::slotted([slot=leading]),
.sui-chip ::slotted([slot=trailing]) {
  display: inline-flex;
  align-items: center;
  color: currentColor;
}
.sui-chip__asset {
  border-radius: 50%;
  overflow: hidden;
}
.sui-chip__asset img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.sui-chip--medium .sui-chip__asset {
  width: 20px;
  height: 20px;
}
.sui-chip--small .sui-chip__asset {
  width: 18px;
  height: 18px;
}
.sui-chip--small {
  font-size: var(--sui-font-size-sm);
  padding: 0 var(--sui-spacing-xs);
  height: 24px;
}
.sui-chip--medium {
  padding: 0 var(--sui-spacing-sm);
}
.sui-chip--general.sui-chip--default {
  background-color: var(--sui-semantic-component-chip-general);
  color: var(--sui-semantic-text-secondary);
}
.sui-chip--general.sui-chip--two-tone {
  background-color: var(--sui-semantic-component-chip-general);
  border-color: var(--sui-semantic-border-alpha-level-3);
  color: var(--sui-semantic-text-secondary);
}
.sui-chip--general.sui-chip--ghost {
  background-color: transparent;
  border-color: var(--sui-semantic-border-alpha-level-3);
  color: var(--sui-semantic-text-secondary);
}
.sui-chip--primary.sui-chip--default {
  background-color: var(--sui-semantic-component-chip-primary);
  color: var(--sui-semantic-text-on-primary);
}
.sui-chip--primary.sui-chip--two-tone {
  background-color: var(--sui-semantic-global-primary-soft);
  border-color: var(--sui-semantic-component-chip-primary);
  color: var(--sui-semantic-component-chip-primary);
}
.sui-chip--primary.sui-chip--ghost {
  background-color: transparent;
  border-color: var(--sui-semantic-component-chip-primary);
  color: var(--sui-semantic-text-accent);
}
.sui-chip--success.sui-chip--default {
  background-color: var(--sui-semantic-global-success-default);
  color: var(--sui-semantic-text-on-primary);
}
.sui-chip--success.sui-chip--two-tone {
  background-color: var(--sui-semantic-global-success-soft);
  border-color: var(--sui-semantic-global-success-default);
  color: var(--sui-semantic-global-success-default);
}
.sui-chip--success.sui-chip--ghost {
  background-color: transparent;
  border-color: var(--sui-semantic-global-success-default);
  color: var(--sui-semantic-global-success-default);
}
.sui-chip--error.sui-chip--default {
  background-color: var(--sui-semantic-global-error-default);
  color: var(--sui-semantic-text-on-primary);
}
.sui-chip--error.sui-chip--two-tone {
  background-color: var(--sui-semantic-global-error-soft);
