.sui-skeleton {
  display: block;
  position: relative;
  overflow: hidden;
  background: var(--sui-semantic-component-skeleton-backgraund);
}
.sui-skeleton__shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.sui-skeleton--shimmer .sui-skeleton__shine {
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.5) 50%, transparent 100%);
  animation: skeleton-shimmer var(--sui-skeleton-duration, 2.5s) ease-in-out infinite;
}
.sui-skeleton--pulse {
  animation: skeleton-pulse var(--sui-skeleton-duration, 2.5s) ease-in-out infinite;
}
.sui-skeleton--wave .sui-skeleton__shine {
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 25%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0.3) 75%, transparent 100%);
  animation: skeleton-wave var(--sui-skeleton-duration, 2.5s) ease-in-out infinite;
}
.sui-skeleton--speed-slow {
  --sui-skeleton-duration: 5s;
}
.sui-skeleton--speed-normal {
  --sui-skeleton-duration: 2.5s;
}
.sui-skeleton--speed-fast {
  --sui-skeleton-duration: 1.2s;
}

.sui-skeleton-group {
  display: flex;
}

.sui-skeleton-carousel {
  display: inline-flex;
  gap: 8px;
  width: 100%;
  justify-content: center;
  height: calc(100% - 12px);
  align-items: end;
}
.sui-skeleton-carousel div {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--sui-surface-level-3);
}
.sui-skeleton-carousel :first-child {
  background: var(--sui-primary-default);
}

@keyframes skeleton-shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}
@keyframes skeleton-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}
@keyframes skeleton-wave {
  0% {
    transform: translateX(-100%);
  }
  50% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(100%);
  }
