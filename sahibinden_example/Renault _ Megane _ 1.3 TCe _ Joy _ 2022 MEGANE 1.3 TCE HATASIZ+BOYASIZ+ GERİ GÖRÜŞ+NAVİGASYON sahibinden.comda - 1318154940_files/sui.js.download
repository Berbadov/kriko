}`;let bs=class extends pe{constructor(){super(...arguments),this.name="",this.size="medium",this.color=""}render(){const e=this.size?this.size:"medium",t=this.color?`color: var(--${this.color}, ${this.color})`:"";return W` <i class="${this.name} ${e}" style="${t}"></i> `}};bs.styles=[ds,ps,hs,ms],i([ge({type:String,attribute:"name"})],bs.prototype,"name",void 0),i([ge({type:String,attribute:"size"})],bs.prototype,"size",void 0),i([ge({type:String,attribute:"color"})],bs.prototype,"color",void 0),bs=i([me("sui-icon")],bs);const fs=c`:host {
  display: block;
  position: relative;
  width: 100%;
}
:host *,
:host *::before,
:host *::after {
  box-sizing: border-box;
}
:host [class^=sui-i-],
:host [class*=" sui-i-"] {
  font-family: "sui-icon-base", serif !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

:host([disabled]) {
  pointer-events: none;
}

.select-trigger {
  display: flex;
  align-items: center;
  position: relative;
  height: 44px;
  width: 100%;
  padding: 0 40px 0 18px;
  margin: 2px 0;
  background-color: var(--sui-semantic-component-select-background);
  border: 1px solid var(--sui-semantic-component-select-border);
  border-radius: var(--sui-border-radius-sm);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  outline: none;
}
.select-trigger:hover {
  border-color: var(--sui-semantic-component-select-hover);
}
.select-trigger:focus {
  background-color: var(--sui-semantic-component-select-active-background);
}
.select-trigger:focus-visible {
  border-color: var(--sui-semantic-component-select-focus);
  box-shadow: 0 0 0 2px var(--sui-semantic-depth-stade-focus-default-color);
}
.select-trigger.opened {
  border-color: var(--sui-semantic-component-select-focus);
  background-color: var(--sui-semantic-component-select-background);
}
.select-trigger.disabled {
  cursor: not-allowed;
  background-color: var(--sui-semantic-component-select-disabeld-background);
  border-color: var(--sui-semantic-border-disabled);
  color: var(--sui-semantic-text-disabled);
}
.select-trigger.disabled .value-text {
  color: var(--sui-semantic-state-disabled-default);
}
.select-trigger.readonly {
  cursor: default;
  background-color: var(--sui-semantic-component-select-disabeld-background);
}
.select-trigger.invalid {
  border-color: var(--sui-semantic-component-select-error);
}
.select-trigger.invalid:focus-visible {
  box-shadow: 0 0 0 2px var(--sui-semantic-depth-stade-focus-error-color);
}

.trigger-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.value-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-regular);
  color: var(--sui-semantic-component-select-value);
  line-height: 1.5;
}

.placeholder-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--sui-font-size-md);
  color: var(--sui-semantic-component-select-placeholder);
  line-height: 1.5;
}

.arrow-icon {
  position: absolute;
  right: var(--sui-spacing-sm);
  top: 50%;
  transform: translateY(-50%);
  font-family: "sui-icon-base", serif !important;
  font-size: var(--sui-icon-large);
  color: var(--sui-semantic-icon-tertiary);
  pointer-events: none;
  transition: transform 0.2s ease;
}
.arrow-icon::after {
  content: var(--sui-i-chevron_down_line);
}
.arrow-icon.opened {
  transform: translateY(-50%) rotate(180deg);
}
.arrow-icon.disabled {
  color: var(--sui-semantic-icon-disabled);
}

.panel {
  position: fixed;
  box-sizing: border-box;
  max-height: 280px;
  overflow-y: auto;
  background-color: var(--sui-semantic-surface-background-level-0);
  border: 1px solid var(--sui-semantic-border-alpha-level-2);
  border-radius: var(--sui-border-radius-sm);
  box-shadow: var(--sui-primitive-depth-3);
  z-index: 9999;
  overscroll-behavior: contain;
}

.filter-box {
  position: sticky;
  top: 0;
  z-index: 1;
  padding: var(--sui-spacing-xs);
  background-color: var(--sui-semantic-surface-background-level-0);
  border-bottom: 1px solid var(--sui-semantic-component-divider-secondary);
}

.filter-input {
  width: 100%;
  height: 36px;
  padding: 0 32px 0 var(--sui-spacing-sm);
  border: 1px solid var(--sui-semantic-component-input-border);
  border-radius: var(--sui-border-radius-sm);
  background-color: var(--sui-semantic-component-input-background);
  font-size: var(--sui-font-size-md);
  color: var(--sui-semantic-component-input-value);
  outline: none;
  transition: border-color 0.2s ease;
}
.filter-input::placeholder {
  color: var(--sui-semantic-component-input-placeholder);
}
.filter-input:focus {
  border-color: var(--sui-semantic-component-input-focus);
}

.filter-search-icon {
  position: absolute;
  right: calc(var(--sui-spacing-xs) + 10px);
  top: 50%;
  transform: translateY(-50%);
  font-family: "sui-icon-base", serif !important;
  font-size: var(--sui-icon-medium);
  color: var(--sui-semantic-icon-tertiary);
  pointer-events: none;
}
.filter-search-icon::before {
  content: var(--sui-i-search);
}

.group-header {
  padding: var(--sui-spacing-xs) var(--sui-spacing-sm);
  font-size: var(--sui-font-size-md);
  font-weight: var(--sui-font-weight-bold);
  color: var(--sui-semantic-text-primary);
  line-height: 1.5;
  user-select: none;
  cursor: default;
}

.option-item {
  display: flex;
  align-items: center;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.1s ease;
  padding: 12px 16px;
  margin-bottom: -1px;
}
.option-item:hover, .option-item.focused {
  background-color: var(--sui-semantic-surface-info);
}
.option-item.selected {
  background-color: var(--sui-semantic-component-select-active-background);
}
.option-item.disabled {
  color: var(--sui-semantic-text-disabled);
  cursor: not-allowed;
}
.option-item.disabled:hover {
  background-color: transparent;
}

.option-label {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--sui-emphasis-high);
  font-size: var(--sui-font-size-lg);
  line-height: normal;
}

.option-checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin-right: var(--sui-spacing-xs);
  border: 1px solid var(--sui-semantic-component-checkbox-unselected);
  border-radius: 3px;
  flex-shrink: 0;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}
.option-checkbox.checked {
  background-color: var(--sui-semantic-component-checkbox-selected);
  border-color: var(--sui-semantic-component-checkbox-selected);
}
.option-checkbox.checked::after {
  font-family: "sui-icon-base", serif !important;
  content: var(--sui-i-check);
  color: var(--sui-semantic-component-checkbox-on-primary);
  font-size: var(--sui-font-size-sm);
}

.check-icon {
  margin-left: auto;
  flex-shrink: 0;
  font-family: "sui-icon-base", serif !important;
  font-size: var(--sui-font-size-lg);
  line-height: normal;
  color: var(--sui-semantic-state-selected-default);
}
.check-icon::after {
  content: var(--sui-i-check);
}

.breadcrumb-path {
  display: inline;
}
.breadcrumb-path .breadcrumb-ancestor {
  color: var(--sui-semantic-text-secondary);
  font-weight: var(--sui-font-weight-regular);
}
.breadcrumb-path .breadcrumb-separator {
  color: var(--sui-semantic-text-tertiary);
  margin: 0 var(--sui-spacing-3xs);
}
.breadcrumb-path .breadcrumb-leaf {
  color: var(--sui-semantic-text-primary);
  font-weight: 500;
