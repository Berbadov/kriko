  box-sizing: border-box;
}

.sui-dropdown {
  position: relative;
}

.sui-dropdown__trigger {
  display: inline-block;
  cursor: pointer;
  outline: none;
}

.sui-dropdown__panel {
  position: fixed;
  min-width: 240px;
  border-radius: var(---sui-border-radius-sm, 4px);
  background: var(--sui-semantic-surface-background-level-0);
  box-shadow: var(--sui-primitive-depth-4);
  z-index: 1000;
  overflow: hidden;
}

.sui-dropdown__caption {
  color: var(--sui-alpha-black-44);
  background-color: var(--sui-gray-40);
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
  text-transform: uppercase;
  padding: var(--sui-spacing-md) var(--sui-spacing-md) var(--sui-spacing-xs) var(--sui-spacing-md);
}

.sui-dropdown__list {
  min-width: 240px;
}

.sui-dropdown__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sui-spacing-sm);
  padding: var(--sui-spacing-sm) var(--sui-spacing-md);
  font-size: var(--sui-font-size-md);
  line-height: var(--sui-line-height-md);
  font-weight: var(--sui-font-weight-regular);
  color: var(--sui-semantic-text-primary);
  cursor: pointer;
  user-select: none;
  min-height: 48px;
  border-bottom: 1px solid var(--sui-semantic-component-divider-secondary);
}
.sui-dropdown__item:hover {
  background-color: var(--sui-semantic-surface-info);
}
.sui-dropdown__item--selected {
  background-color: var(--sui-semantic-surface-info);
  color: var(--sui-semantic-text-primary);
}

.sui-dropdown__item--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.sui-dropdown__item-main {
  display: flex;
  align-items: center;
  gap: var(--sui-spacing-sm);
  flex: 1;
  min-width: 0;
}

.sui-dropdown__item-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sui-dropdown__item-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sui-dropdown__item-description {
  color: var(--sui-semantic-text-secondary);
  font-size: var(--sui-font-size-sm);
  line-height: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sui-dropdown__item-icon {
  width: 16px;
  height: 16px;
  font-size: 16px;
  color: var(--sui-semantic-text-secondary);
  flex-shrink: 0;
}

.sui-dropdown__item-count {
  flex-shrink: 0;
  font-size: var(--sui-font-size-sm);
  color: var(--sui-semantic-text-secondary);
}

.sui-dropdown__item-radio {
  appearance: none;
  width: 20px;
  height: 20px;
  border: 1px solid var(--sui-emphasis-medium);
  border-radius: 50%;
  background-color: var(--sui-white, #fff);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 10px 10px;
  flex-shrink: 0;
  pointer-events: none;
}
.sui-dropdown__item-radio:checked {
  border-color: var(--sui-primary);
  border-width: 2px;
  background-image: radial-gradient(circle, var(--sui-primary) 0 5px, transparent 5px);
}
.sui-dropdown__item-radio:disabled {
  opacity: 0.5;
  border-color: var(--sui-emphasis-disabled);
}
.sui-dropdown__item-radio:checked:disabled {
  background-image: radial-gradient(circle, var(--sui-emphasis-disabled) 0 5px, transparent 5px);
}

.sui-dropdown__item--selected .sui-dropdown__item-count {
  color: inherit;
}

.sui-dropdown__mobile-list {
  padding: 0;
}
.sui-dropdown__mobile-list .sui-dropdown__item {
  white-space: normal;
}

.sui-dropdown__list--slotted {
  display: flex;
  flex-direction: column;
}

::slotted(:not([slot])) {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: var(--sui-spacing-sm) !important;
  margin: 0 !important;
  padding: var(--sui-spacing-sm) var(--sui-spacing-md) !important;
  font-family: inherit;
  font-size: var(--sui-font-size-md) !important;
  line-height: var(--sui-line-height-md) !important;
  font-weight: var(--sui-font-weight-regular) !important;
  color: var(--sui-semantic-text-primary) !important;
  cursor: pointer !important;
  user-select: none !important;
  min-height: 48px !important;
  border-top: 0 !important;
  border-right: 0 !important;
  border-bottom: 1px solid var(--sui-semantic-component-divider-secondary) !important;
  border-left: 0 !important;
  border-radius: 0 !important;
  text-decoration: none !important;
  background: transparent !important;
  text-align: left !important;
  width: 100% !important;
  box-sizing: border-box !important;
  outline: none;
}

::slotted(:not([slot]):hover) {
  background-color: var(--sui-semantic-surface-info) !important;
}

::slotted(a:not([slot])),
::slotted(a:not([slot]):link),
::slotted(a:not([slot]):visited),
::slotted(a:not([slot]):focus),
::slotted(a:not([slot]):active) {
  color: var(--sui-semantic-text-primary) !important;
  text-decoration: none !important;
  background: transparent !important;
}

::slotted(a:not([slot]):hover) {
  background-color: var(--sui-semantic-surface-info) !important;
  color: var(--sui-semantic-text-primary) !important;
  text-decoration: none !important;
}

::slotted(button:not([slot])),
::slotted(button:not([slot]):focus),
::slotted(button:not([slot]):active) {
  color: var(--sui-semantic-text-primary) !important;
  background: transparent !important;
  appearance: none !important;
  -webkit-appearance: none !important;
}

::slotted(button:not([slot]):hover) {
  background-color: var(--sui-semantic-surface-info) !important;
  color: var(--sui-semantic-text-primary) !important;
}

::slotted(:not([slot]):last-child) {
  border-bottom: 0 !important;
