  left: 0;
  transform: translateY(0);
  font-size: 16px;
  color: var(--sui-semantic-component-mobil-select-focus);
}
:host .mobile-select-container:focus-within {
  border-bottom-color: var(--sui-semantic-component-mobil-select-focus);
}
:host .mobile-select-container:focus-within .label {
