# Copy to deploy/.env and fill in real values before running docker compose.
POSTGRES_PASSWORD=change_me_in_production
# CORS: add your extension ID after installing it in Chrome
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID_HERE
ALLOWED_ORIGINS=chrome-extension://localhost

# Knowledge pipeline — offline use only, not needed by the API container.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
