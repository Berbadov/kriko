# Copy to deploy/.env and fill in real values before running docker compose.
POSTGRES_PASSWORD=change_me_in_production
# CORS: add your extension ID after installing it in Chrome
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID_HERE
ALLOWED_ORIGINS=chrome-extension://localhost

# Knowledge pipeline — offline use only, not needed by the API container.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Debug read path (docs/design_flaws.md "Observability gap"): GET /debug/analyses
# returns full logged request/response payloads. Off (404) unless set to true —
# only turn this on temporarily, over HTTPS, when shell access to the deploy host
# isn't available. The CLI (python -m backend.tools.analyses) needs neither this
# flag nor network access at all.
# ENABLE_DEBUG_ENDPOINT=true
