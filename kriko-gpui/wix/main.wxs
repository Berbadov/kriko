<?xml version='1.0' encoding='utf-8'?>
<!--
  Kriko's installer: one per-user MSI, no UAC prompt.

  It installs under %LOCALAPPDATA%\Programs\Kriko and carries two programs:

    kriko.exe          the desktop app (GPUI)
    kriko-sidecar.exe  the engine, which the app starts and supervises

  The sidecar is built by PyInstaller (packaging/kriko-sidecar.spec) and
  placed beside kriko.exe in the cargo output directory by package.ps1, so
  both come from $(var.CargoTargetBinDir). `cargo wix` fills in Version and
  CargoTargetBinDir; package.ps1 is the one place that runs it.

  What an installer owes this app, and where it is paid:

  * Nothing of ours may be running while files are replaced or removed. The
    sidecar maps its own image, so a live one fails the copy. StopKriko runs
    first and StopEngine second: ending kriko.exe closes the sidecar's stdin,
    which is the engine's designed way out, and the second kill is the belt.
    Both are tree kills (/T) because the one-file bundle re-executes, so the
    pid that holds the file is a child of the one a name finds. They run
    before the old version is removed (upgrade) and before files go
    (uninstall). A "not found" is the expected answer, so neither can fail
    the install.
  * A per-user install must not touch the machine: no PATH entry, nothing
    under Program Files, nothing needing elevation.
  * Every component's key path is a value under HKCU, which is what Windows
    Installer asks of anything written into a user profile (ICE38), and every
    folder this creates is removed again (ICE64).
-->

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Kriko'
        UpgradeCode='D4A3E5B4-6C7D-4C42-8B0D-0FE43E4E5F21'
        Manufacturer='Kriko'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Kriko: local product knowledge'
            Manufacturer='Kriko'
            InstallerVersion='500'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'
            />

        <!--
          Upgrade-aware: a newer MSI replaces an older one, an older one
          refuses. The old version is removed after the stop actions below
          have run, so its files are not held.
        -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Kriko Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramMenuFolder' Name='ProgMenu'/>
            <Directory Id='DesktopFolder' Name='Desktop'/>
            <Directory Id='LocalAppDataFolder' Name='LocalAppData'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='Kriko'>

                        <Component Id='AppFolder' Guid='*'>
                            <RemoveFolder Id='RemoveAppFolder' On='uninstall'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='folder' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>

                        <Component Id='KrikoExe' Guid='*'>
                            <File Id='KrikoExe' Name='kriko.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\kriko.exe' KeyPath='no'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='kriko.exe' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>

                        <Component Id='SidecarExe' Guid='*'>
                            <File Id='SidecarExe' Name='kriko-sidecar.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\kriko-sidecar.exe' KeyPath='no'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='kriko-sidecar.exe' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>

                        <Component Id='StartMenuKriko' Guid='*'>
                            <Shortcut
                                Id='StartMenuKriko'
                                Directory='ProgramMenuFolder'
                                Name='Kriko'
                                Description='Kriko: local product knowledge'
                                Target='[APPLICATIONFOLDER]kriko.exe'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Icon='KrikoIcon.ico'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='start-menu' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>

                        <!--
                          The operator console, as something you double-click:
                          the engine binary with its tui flag, drawn with the app's
                          icon. A console window appears on purpose, because
                          the terminal is the interface here.
                        -->
                        <Component Id='StartMenuConsole' Guid='*'>
                            <Shortcut
                                Id='StartMenuConsole'
                                Directory='ProgramMenuFolder'
                                Name='Kriko Console'
                                Description='Kriko operator console'
                                Target='[APPLICATIONFOLDER]kriko-sidecar.exe'
                                Arguments='--tui'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Icon='KrikoIcon.ico'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='start-menu-console' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>

                        <Component Id='DesktopKriko' Guid='*'>
                            <Shortcut
                                Id='DesktopKriko'
                                Directory='DesktopFolder'
                                Name='Kriko'
                                Description='Kriko: local product knowledge'
                                Target='[APPLICATIONFOLDER]kriko.exe'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Icon='KrikoIcon.ico'/>
                            <RegistryValue Root='HKCU' Key='Software\Kriko\Installer' Name='desktop' Type='integer' Value='1' KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Kriko'
            Description='The app, its engine and the shortcuts.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Absent='disallow'>
            <ComponentRef Id='AppFolder'/>
            <ComponentRef Id='KrikoExe'/>
            <ComponentRef Id='SidecarExe'/>
            <ComponentRef Id='StartMenuKriko'/>
            <ComponentRef Id='StartMenuConsole'/>
            <ComponentRef Id='DesktopKriko'/>
        </Feature>

        <!--
          Stop a running Kriko: the app first, then the engine. Immediate
          actions are enough because nothing here needs elevation, and they
          sit right after InstallInitialize, before the old version is removed
          and before any file is touched. WixQuietExec reads QtExecCmdLine and
          runs it without a console window; Return='ignore' because "no such
          process" is the normal outcome.
        -->
        <CustomAction Id='SetStopKriko' Property='QtExecCmdLine' Value='&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM kriko.exe'/>
        <CustomAction Id='StopKriko' BinaryKey='WixCA' DllEntry='WixQuietExec' Execute='immediate' Return='ignore'/>
        <CustomAction Id='SetStopEngine' Property='QtExecCmdLine' Value='&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM kriko-sidecar.exe'/>
        <CustomAction Id='StopEngine' BinaryKey='WixCA' DllEntry='WixQuietExec' Execute='immediate' Return='ignore'/>
        <InstallExecuteSequence>
            <Custom Action='SetStopKriko' Before='RemoveExistingProducts'/>
            <Custom Action='StopKriko' After='SetStopKriko'/>
            <Custom Action='SetStopEngine' After='StopKriko'/>
            <Custom Action='StopEngine' After='SetStopEngine'/>
        </InstallExecuteSequence>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='KrikoIcon.ico' SourceFile='assets/kriko.ico'/>
        <Property Id='ARPPRODUCTICON' Value='KrikoIcon.ico'/>
        <Property Id='ARPHELPLINK' Value='https://kriko.local'/>
    </Product>

</Wix>
