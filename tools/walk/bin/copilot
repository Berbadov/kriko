#!/usr/bin/env bash
# A stand-in `copilot` (GitHub Copilot CLI); see `agy` beside it.
if [ "${1:-}" = "--help" ]; then cat <<'HELP'
Usage: copilot [options]
  -p, --prompt <text>          Run non-interactively
  --output-format <format>     text or json
  --allow-all-tools            Allow every tool
  --no-ask-user                Never ask
  --available-tools <tools>    Only these tools
  --disable-builtin-mcps       No built-in MCP servers
  --no-custom-instructions     Skip instruction files
  --no-auto-update             Do not update
  --no-color                   Plain output
  --log-level <level>          Log level
  --model <model>              Model to use (e.g. 'walk-eta' or 'walk-theta')
  --effort <level>             Reasoning effort (low, medium, high, xhigh)
HELP
exit 0; fi
echo '{"type":"assistant.message","data":{"content":"{\"findings\": []}"}}'
echo '{"type":"result","exitCode":0}'
