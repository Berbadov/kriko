#!/usr/bin/env bash
# A stand-in `agy`. `models` sleeps like the real one does (it asks a server),
# which is the delay the Agents screen must not pay on every click.
case "${1:-}" in
    --help) printf '%s\n' "Usage: agy [options]" "  -p, --prompt <text>" \
        "  --output-format <fmt>   text|json|stream-json" "  --model <id>" "  --effort <level>   (low, medium, high)" \
        "  --disable-slash-commands" ;;
    models) sleep "${KRIKO_WALK_MODELS_DELAY:-2}"
        printf 'ID\tNAME\nwalk-gamma\tWalk Gamma\nwalk-delta\tWalk Delta\n' ;;
    *) echo '{"type":"result","result":"{\"findings\": []}"}' ;;
esac
