#!/usr/bin/env bash
# A stand-in `claude` for tools/walk.sh: it answers the questions Kriko asks
# (`--help`, a headless run) instantly and spends nothing. Its `--model` entry
# is shaped like the real CLI's, so the Agents screen lists what it quotes.
if [ "${1:-}" = "--help" ]; then cat <<'HELP'
Usage: claude [options] [command] [prompt]
  -p, --print                           Print response and exit
  --output-format <format>              "text", "json" or "stream-json"
  --verbose                             Verbose output
  --allowedTools <tools...>             Tools to allow
  --model <model>                       Model for the current session. Provide
                                        an alias for the latest model (e.g.
                                        'walk-alpha' or 'walk-beta') or a
                                        model's full name (e.g.
                                        'walk-alpha-1').
  --strict-mcp-config                   Only use MCP servers from --mcp-config
  --safe-mode                           Skip user configuration
HELP
exit 0; fi
echo '{"type":"system","subtype":"init","model":"walk-alpha"}'
echo '{"type":"result","result":"{\"findings\": []}","usage":{"input_tokens":1,"output_tokens":1},"total_cost_usd":0}'
