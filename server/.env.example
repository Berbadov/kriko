# A long random string: openssl rand -hex 32
KRIKO_CLOUD_SECRET=
# The word that lets your first device claim the relay: openssl rand -hex 16
KRIKO_CLOUD_SETUP=
# The name that points at this machine, for the certificate
RELAY_DOMAIN=relay.example.com
# Where alerts are pushed. The public server sees the label and price; run your own to keep them.
KRIKO_CLOUD_NTFY=https://ntfy.sh
