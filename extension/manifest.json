{
    "manifest_version": 3,
    "name": "Kriko",
    "description": "Shows what is known to go wrong with the product on the page you are reading.",
    "version": "0.4.1",
    "permissions": ["activeTab", "storage", "scripting", "alarms"],
    "optional_host_permissions": ["https://*/*"],
    "host_permissions": ["http://127.0.0.1/*"],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
    },
    "action": {
        "default_title": "Kriko",
        "default_icon": {
            "16": "assets/icons/icon-16.png",
            "32": "assets/icons/icon-32.png",
            "48": "assets/icons/icon-48.png"
        }
    },
    "commands": {
        "toggle-panel": {
            "suggested_key": {
                "default": "Alt+K"
            },
            "description": "Show or hide the Kriko panel on this page"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "web_accessible_resources": [
        {
            "resources": ["hover_lite/hover_lite.css", "assets/fonts/*.ttf"],
            "matches": ["https://*/*"],
            "use_dynamic_url": true
        }
    ]
}
