# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Env / secrets
.env

# Knowledge pipeline candidate cache (regenerated per run)
.cache/

# Full-payload /analyze log — local/deploy-host only
logs/

# Claude Code local tool state (worktrees, local settings) — but the shared
# agent definitions are project config and belong in the repo.
.claude/
!.claude/agents/
!.claude/agents/**

# Evidence ledger (append-only database and exports)
kriko/ledger.db
packs/cars/pipeline/ledger.db
packs/cars/pipeline/ledger_export/

# Local no-Docker SQLite DB (scripts/run_local.sh)
local.db

# Node deps for the extension scraper tests (npm test)
node_modules/

# package-lock.json is NOT ignored, and used to be -- as a bare pattern, which
# matches at every depth, so it swallowed the root lockfile and tauri's.
# That is how `@tauri-apps/cli: "^2"` came to float: v0.2.1 opened and v0.2.4,
# four hours later, panicked on a byte-identical tree. A release that cannot
# be rebuilt is not a release.


# Pytest scratch
.pytest_cache/

# Pipeline run log — append-only runtime record, one line per research run
app/pipeline/runs.jsonl

# Catalog generation cache (regenerated by packs/cars/pipeline/catalog/discover.py)
packs/cars/pipeline/cache/

# Saved Sahibinden listing used as a scraper reference sample. 7.8 MB of
# mirrored page assets, referenced by no code, test or doc — kept on disk
# for eyeballing markup changes, out of the repo because it never diffs
# meaningfully.
sahibinden_example/

# Built packs (regenerated by `python -m packs.<name>.build`)
dist/

# Editable-install build metadata (regenerated by `pip install -e .`)
src/*.egg-info/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# The desktop shell's build products. The Rust target directory is ~2GB, the
# frozen sidecar is per-OS, and `tauri icon` generates every icon in
# src-tauri/icons/ from packaging/icon-master.png -- including icon.png,
# which is why the master is not in that directory. It used to be, and the
# command re-encoded its own input on every build.
tauri/node_modules/
tauri/src-tauri/target/
tauri/src-tauri/binaries/
tauri/src-tauri/gen/
tauri/src-tauri/icons/*
build/

# Something in this working tree drops files with non-UTF-8 names (an
# imgui layout, by its contents). Six of them were once committed and made
# `git checkout` fail outright on Windows and macOS - see
# test_every_tracked_path_is_checkoutable_on_windows_and_macos. Ignored by
# their literal bytes so no `git add -A` can pick one up again.
0�d


# Hand-run build transcripts from packaging/build_desktop.ps1 — the recipe
# writes one per run on the Windows host, and it is a log, not a source.
build.log

# GPUI desktop app build artifacts (rebuild with kriko-gpui/package.ps1)
kriko-gpui/target/
kriko-gpui/builds/

# Scratch image crops from the design pass
_c.png
_crop.png

# Zed editor state
.zed/

# Local screenshots and proofs
.walk/
