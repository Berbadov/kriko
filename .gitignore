knowledge/ledger_export/

# Local no-Docker SQLite DB (scripts/run_local.sh)
local.db

# Node deps for the extension scraper tests (npm test)
node_modules/
package-lock.json
knowledge/ledger/ledger.db

# Pytest scratch
.pytest_cache/

# Hub run log — append-only runtime record, one line per research run
knowledge/hub/runs.jsonl

# Catalog generation cache (regenerated by knowledge/catalog/discover.py)
knowledge/catalog/cache/

# Saved Sahibinden listing used as a scraper reference sample. 7.8 MB of
