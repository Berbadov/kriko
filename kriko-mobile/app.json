{
  "expo": {
    "name": "Kriko Prototype",
    "slug": "kriko-mobile",
    "version": "0.3.0",
    "scheme": "kriko",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#03060F",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kriko.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kriko reads a screenshot on this phone to work out which product it shows. The image is never uploaded."
      }
    },
    "android": {
      "package": "app.kriko.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#2862FF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": ["android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03060F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
